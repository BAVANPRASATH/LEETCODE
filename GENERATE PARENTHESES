class Solution:
    def generateParenthesis(self, n):
        result = []

        def backtrack(current_str, open_count, close_count):
            # Base case: we have placed all opening and closing parentheses
            if len(current_str) == 2 * n:
                result.append(current_str)
                return

            # We can place an opening bracket if we haven't used all n brackets
            if open_count < n:
                backtrack(current_str + "(", open_count + 1, close_count)

            # We can place a closing bracket only if it matches an open one
            if close_count < open_count:
                backtrack(current_str + ")", open_count, close_count + 1)

        backtrack("", 0, 0)
        return result
