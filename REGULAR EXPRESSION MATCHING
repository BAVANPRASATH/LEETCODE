class Solution(object):
    def isMatch(self, s, p):
        m, n = len(s), len(p)
        
        # dp[i][j] will be True if s[:i] matches p[:j]
        dp = [[False] * (n + 1) for _ in range(m + 1)]
        dp[0][0] = True
        
        # Patterns like a*, a*b*, a*b*c* can match an empty string
        for j in range(2, n + 1):
            if p[j - 1] == '*':
                dp[0][j] = dp[0][j - 2]
                
        for i in range(1, m + 1):
            for j in range(1, n + 1):
                if p[j - 1] == '*':
                    # Case 1: Count preceding element 0 times -> dp[i][j - 2]
                    # Case 2: Count preceding element 1+ times -> dp[i - 1][j] (if chars match)
                    matches = (p[j - 2] == s[i - 1] or p[j - 2] == '.')
                    dp[i][j] = dp[i][j - 2] or (matches and dp[i - 1][j])
                else:
                    matches = (p[j - 1] == s[i - 1] or p[j - 1] == '.')
                    dp[i][j] = matches and dp[i - 1][j - 1]
                    
        return dp[m][n]
