class Solution:
    def longestCommonPrefix(self, strs):
        if not strs:
            return ""

        # Take the first word as a reference
        first_word = strs[0]

        # Compare each character across all words
        for i, char in enumerate(first_word):
            for word in strs[1:]:
                # If a word is shorter than the index or characters mismatch
                if i >= len(word) or word[i] != char:
                    return first_word[:i]

        return first_word
