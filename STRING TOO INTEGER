class Solution(object):
    def myAtoi(self, s):
        s = s.strip()
        if not s:
            return 0
        
        sign = 1
        i = 0
        
        if s[0] == '-':
            sign = -1
            i = 1
        elif s[0] == '+':
            i = 1
            
        num = 0
        while i < len(s) and s[i].isdigit():
            num = num * 10 + int(s[i])
            i += 1
            
        val = sign * num
        
        # 32-bit integer limits
        low = -2147483648
        high = 2147483647
        
        if val < low:
            return low
        if val > high:
            return high
            
        return val
