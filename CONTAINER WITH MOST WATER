class Solution(object):
    def maxArea(self, height):
        left = 0
        right = len(height) - 1
        max_water = 0

        while left < right:
            # Water area = width * min(left_height, right_height)
            width = right - left
            h = min(height[left], height[right])
            current_water = width * h
            
            if current_water > max_water:
                max_water = current_water

            # Always shift the shorter line inward
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1

        return max_water
